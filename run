#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PY="$ROOT_DIR/.venv/bin/python"
NODE_BIN="$(command -v node || true)"

if [[ ! -x "$VENV_PY" ]]; then
  echo "Error: .venv not found. Create it with: python3 -m venv .venv" >&2
  exit 1
fi

if [[ $# -gt 0 ]]; then
  echo "Error: this script no longer accepts command-line parameters." >&2
  echo "Run ./run and choose from the menu." >&2
  exit 1
fi

echo "Choose an output format:"
echo "  1) PDF"
echo "  2) Web page"
echo "  3) EPUB"

while true; do
  read -r -p "Enter number (1-3): " choice
  case "$choice" in
    1)
      "$VENV_PY" "$ROOT_DIR/render.py"
      break
      ;;
    2)
      if [[ -z "$NODE_BIN" ]]; then
        echo "Error: node is required for web generation but was not found on PATH." >&2
        echo "Install node to proceed." >&2
        exit 1
      fi
      "$NODE_BIN" "$ROOT_DIR/render_web.mjs"
      break
      ;;
    3)
      "$VENV_PY" "$ROOT_DIR/render_epub.py"
      break
      ;;
    *)
      echo "Invalid selection. Try again." >&2
      ;;
  esac
done
